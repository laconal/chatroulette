# Telegram
BOT_TOKEN=
# Public HTTPS address served by Nginx; Telegram calls WEBHOOK_BASE_URL + WEBHOOK_PATH
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/webhook
# Any random string of A-Z, a-z, 0-9, _ and -; Telegram sends it with every update
WEBHOOK_SECRET=

# Host port of the bot container (bound to 127.0.0.1), the target of Nginx proxy_pass
BOT_PORT=8085

# PostgreSQL
POSTGRES_USER=chatroullete
POSTGRES_PASSWORD=
POSTGRES_DB=chatroullete
# Host ports (bound to 127.0.0.1). Inside docker compose the bot always uses the default ports.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Needed only when the bot runs outside docker compose
# POSTGRES_HOST=localhost
# REDIS_HOST=localhost
# REDIS_DB=0
# WEBAPP_HOST=127.0.0.1
# WEBAPP_PORT=8085

# A room with no messages for this long is closed automatically
ROOM_IDLE_TIMEOUT_SECONDS=600
# How often idle rooms are looked for
ROOM_IDLE_CHECK_INTERVAL_SECONDS=30

# Interface language for users whose Telegram language is not supported: ru, en, uz, uz_cyrl
DEFAULT_LANGUAGE=ru
# Allowed age range in settings
MIN_AGE=18
MAX_AGE=99
